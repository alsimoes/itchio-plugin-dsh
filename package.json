{
  "name": "itchio-plugin-dsh",
  "version": "1.1.0",
  "private": true,
  "description": "itch.io Plugin for the DeepSeek Harness: publish game builds with the official butler CLI, plus a cross-platform Node.js release CLI.",
  "type": "module",
  "license": "MIT",
  "author": "André Simões",
  "repository": "github:alsimoes/itchio-plugin-dsh",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "itchio",
    "butler",
    "release",
    "game-development"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
